{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "comment" : "An empty label (a text field whose placeholder is given separately). Leave it empty.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        }
      }
    },
    "%@ (not connected)" : {
      "comment" : "Settings › Dictation › Microphone: menu item for the microphone the user picked when it is not connected. %@ is the microphone's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (no conectado)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (не під'єднано)"
          }
        }
      }
    },
    "%@ billed" : {
      "comment" : "Usage page, Requests: audio a vendor billed. %@ is a duration, e.g. 12 min.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ facturado"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплачено: %@"
          }
        }
      }
    },
    "%@ billed (%lld of %lld reported)" : {
      "comment" : "Usage page, Requests: audio billed, when only some requests reported it. %@ is a duration; the numbers are requests.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ billed (%2$lld of %3$lld reported)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ facturado (%2$lld de %3$lld informados)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплачено: %1$@ (повідомлено %2$lld з %3$lld)"
          }
        }
      }
    },
    "%@ charges about %@ an hour more for a transcription that carries them." : {
      "comment" : "Dictionary page, What a word does: sentence after the count. The first %@ is the vendor, the second a price (e.g. $0.12).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ charges about %2$@ an hour more for a transcription that carries them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cobra unos %2$@ más por hora por una transcripción que las incluye."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ бере приблизно на %2$@ на годину більше за транскрипцію з ними."
          }
        }
      }
    },
    "%@ didn't come back to the front, so nothing was pasted into it." : {
      "comment" : "Notice beside the dictation overlay: text under the title. after AI Rewrite in the Record Window. %@ is an app's name, or 'The app'.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no volvió al frente, así que no se pegó nada en ella."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не повернувся на передній план, тож у нього нічого не вставлено."
          }
        }
      }
    },
    "%@ faster" : {
      "comment" : "Usage page: the large figure, how much faster speaking is than typing. %@ is e.g. 3.6× (shown larger).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ más rápido"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ швидше"
          }
        }
      }
    },
    "%@ in all · %@" : {
      "comment" : "Usage page, the chart's note: the period's total cost. The first %@ is a cost, e.g. ≈ $1.20; the second says it is estimated from known prices.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in all · %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en total · %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усього %1$@ · %2$@"
          }
        }
      }
    },
    "%@ is already the %@ shortcut. Choose another one." : {
      "comment" : "Settings › Dictation › Shortcuts: warning under a shortcut. The first %@ is the keys (e.g. ⌃⇧Q), the second the name of the other shortcut that already uses them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already the %2$@ shortcut. Choose another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya es el atajo de %2$@. Elige otro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — уже скорочення для «%2$@». Виберіть інше."
          }
        }
      }
    },
    "%@ is given them" : {
      "comment" : "Dictionary page, What a word does: row title. %@ is the speech engine's vendor (e.g. OpenAI); 'them' is the user's words.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ las recibe"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отримує їх"
          }
        }
      }
    },
    "%@ is newer." : {
      "comment" : "Settings › Speech to text / AI Rewrite: note under a service's models when a newer model replaces the selected one. %@ is the newer model's name. Followed by a 'Switch to it' link.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es más reciente."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ новіша."
          }
        }
      }
    },
    "%@ is reserved by another app, so it won't work. Choose another shortcut." : {
      "comment" : "Settings › Dictation › Shortcuts: warning under a shortcut macOS would not register. %@ is the keys, e.g. ⌃⇧Q.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está reservado por otra app, así que no funcionará. Elige otro atajo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зайняте іншою програмою, тож не спрацює. Виберіть інше скорочення."
          }
        }
      }
    },
    "%@ isn't downloaded — download it in Settings › AI Rewrite." : {
      "comment" : "Error when a local AI Rewrite model is missing. %@ is the model's name; Settings › AI Rewrite is a place in Settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está descargado: descárgalo en Ajustes › Reescritura con IA."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не завантажено — завантажте її в Параметрах › ШІ‑переписування."
          }
        }
      }
    },
    "%@ isn't given them" : {
      "comment" : "Dictionary page, What a word does: row title. %@ is the name of the speech model in use.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
