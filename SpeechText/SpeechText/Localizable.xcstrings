    "**Not in the list?** Drag SpeechText into it, or click + under the list and choose it in Applications." : {
      "comment" : "Setup window: helper panel beside System Settings › Privacy & Security › Accessibility. ** marks bold. Applications is the Finder folder; use its name in your language."
    },
    "+%lld" : {
      "comment" : "Dictionary page: on a word's card, how many more wrong spellings there are than the four shown, e.g. +3."
    },
    "40 wpm, an average. Measure yours for a fair comparison." : {
      "comment" : "Usage page, How this is counted: when the user hasn't measured their typing speed."
    },
    "A dictation being typed into %@" : {
      "comment" : "Home page: VoiceOver label of the animated example of a dictation. %@ is an app name."
    },
    "A good explanation feels obvious afterwards, as if the idea had been waiting patiently for someone to say it out loud." : {
      "comment" : "Usage page, typing test: a sentence to type. Write a natural sentence of about the same length in your language; it is only for timing the typing."
    },
    "A key is like a password that lets SpeechText use your account." : {
      "comment" : "Setup window: under 'Connect your … account', explains what an API key is."
    },
    "A menu" : {
      "comment" : "Stands in for a menu's name when it is unknown, at the start of a sentence: 'A menu was open and had the keyboard…'."
    },
    "A retry from History is sent to Groq, since Apple can't transcribe a saved recording." : {
      "comment" : "Settings › Privacy & Data › What leaves this Mac › Your voice: second sentence when Apple Dictation is in use and a Groq key is stored. Groq is a company name."
    },
    "A typical wait for an answer: half were faster, half slower." : {
      "comment" : "Usage page, Requests: tooltip on the typical wait."
    },
    "AI" : {
      "comment" : "Record Window (the app's floating dictation window): status line after AI Rewrite changed the text, when no prompt name is known."
    },
    "AI POLISH" : {
      "comment" : "Setup window, Try it step: small label in capitals over the AI dictation's result."
    },
    "AI Recording" : {
      "comment" : "Menu bar menu item. Starts a dictation that AI Rewrite rewrites before pasting. Title case, as macOS menus are in English."
    },
    "AI Rewrite" : {
      "comment" : "The app's AI Rewrite feature, as a button label or an undo action name ('Undo AI Rewrite')."
    },
    "AI Rewrite is off, so nothing is sent." : {
      "comment" : "Settings › Privacy & Data › What leaves this Mac › Your text: when AI Rewrite has no provider."
    },
    "AI Rewrite keeps them as written" : {
      "comment" : "Dictionary page, What a word does: row title. AI Rewrite is a feature of the app; 'them' is the user's words."
    },
    "AI Rewrite pastes your words as said until you add a key." : {
      "comment" : "Settings › AI Rewrite › Online services: note under the selected service that has no API key."
    },
    "AI Rewrite was told it was for %@" : {
      "comment" : "History page, an open AI dictation: what AI Rewrite was told about where the text was going. %@ is that place, e.g. 'a message in Slack'."
    },
    "AI couldn't answer this time" : {
      "comment" : "Setup window, Try it step: title when the AI dictation failed."
    },
    "AI cut this to %lld%% of its length — kept what you dictated" : {
      "comment" : "Record Window (the app's floating dictation window): status line when AI Rewrite's reply was refused for being too short. %lld%% is a percentage, e.g. 20%."
    },
    "AI dictation" : {
      "comment" : "Dictation overlay: VoiceOver name of a dictation that AI Rewrite rewrites."
    },
    "AI dictation — rewritten before it is pasted" : {
      "comment" : "Dictation overlay: tooltip on the mode mark during an AI dictation."
    },
    "AI dictations and edits are sent to %@. With it go your Dictionary's words and the app, window title and field the text is for — a window title can show an email subject. Password managers and password fields are never read." : {
      "comment" : "Settings › Privacy & Data › What leaves this Mac › Your text: when an online AI service is in use. %@ is the company, e.g. Anthropic. Dictionary is a page of the app."
    },
    "AI edit failed" : {
      "comment" : "Notice beside the dictation overlay: title, one short line. Edit Selection with AI (rewrites the text selected in another app): the AI provider returned an error, shown as the text."
    },
    "AI failed: %@" : {
      "comment" : "Record Window (the app's floating dictation window): status line. %@ is the error message."
    },
    "AI is tidying up your text…" : {
      "comment" : "Setup window, Try it step: title while AI polish rewrites what was said."
    },
    "AI isn't set up" : {
      "comment" : "Notice beside the dictation overlay: title, one short line. Edit Selection with AI (rewrites the text selected in another app): "
    },
    "AI mode off — text is inserted as transcribed" : {
      "comment" : "Record Window (the app's floating dictation window): tooltip on the AI Rewrite button when it is off."
    },
    "AI mode on — dictation is rewritten using your prompt presets" : {
      "comment" : "Record Window (the app's floating dictation window): tooltip on the AI Rewrite button when it is on."
    },
    "AI model" : {
      "comment" : "Setup window: what is downloading in the corner pill — the AI model (as opposed to the speech model). Inserted into '%@ · %lld%%', '✓ %@ ready' and '⚠︎ %@ download failed · Retry'."
    },
    "AI output" : {
      "comment" : "History page, an open AI dictation: title over the text AI Rewrite wrote."
    },
    "AI polish is almost ready" : {
      "comment" : "Setup window, Try it step: title while the AI model is still downloading. AI polish is the setup's name for AI Rewrite."
    },
    "AI polish is ready — it uses your %@ key." : {
      "comment" : "Setup window, AI step: shown instead of the key form when the key entered on the Speech step works for AI too. %@ is the service, e.g. Groq."
    },
    "AI processing failed" : {
      "comment" : "Notice beside the dictation overlay: title, one short line. AI Rewrite failed and the dictation was pasted as transcribed."
    },
    "AI processing skipped" : {
      "comment" : "Notice beside the dictation overlay: title, one short line. AI Rewrite isn't set up, so the dictation was pasted as transcribed."
    },
    "AI · %@" : {
      "comment" : "Record Window (the app's floating dictation window): status line after AI Rewrite changed the text. %@ is the name of the prompt it used."
    },
    "API Keys" : {
      "comment" : "Settings: name of the page (sidebar entry and page title) that holds every API key."
    },
    "About" : {
      "comment" : "Settings › General: group heading over the version and links, in a build with no automatic updates."
    },
    "About SpeechText" : {
      "comment" : "App menu item that opens the About panel. SpeechText is the app's name."
    },
    "Accent" : {
      "comment" : "Settings › Appearance › Color: row whose swatches set the accent color."
    },
    "Accessibility" : {
      "comment" : "Settings › Privacy & Data › Permissions: the macOS Accessibility permission, as named in System Settings."
