          }
        }
      }
    },
    "Just talk, or say what you want — AI pastes the finished text." : {
      "comment" : "Home page, More ways to dictate: the AI Rewrite tile's text.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
