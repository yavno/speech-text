    },
    "%@ tokens in · %@ out" : {
      "comment" : "Usage page, Requests: tokens sent and received, e.g. 48.2k tokens in · 3.1k out.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ tokens in · %2$@ out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tokens de entrada · %2$@ de salida"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токенів: %1$@ на вхід · %2$@ на вихід"
          }
        }
      }
    },
    "%@ took it out late, once it wasn't in front. Paste it back with ⌘V." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'The app'. ⌘V is the paste shortcut.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo quitó tarde, cuando ya no estaba al frente. Vuelve a pegarlo con ⌘V."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ забрав текст запізно, коли вже не був на передньому плані. Вставте його знову за допомогою ⌘V."
          }
        }
      }
    },
    "%@ was open and had the keyboard, so nothing was pasted into %@." : {
      "comment" : "Notice beside the dictation overlay: text under the title. the first %@ is a menu's name or 'A menu', the second an app's name or 'the app'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was open and had the keyboard, so nothing was pasted into %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ estaba abierto y tenía el teclado, así que no se pegó nada en %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ було відкрито й воно мало фокус клавіатури, тож у %2$@ нічого не вставлено."
          }
        }
      }
    },
    "%@ was open and had the keyboard. The text is in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. %@ is a menu's name, or 'A menu'.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estaba abierto y tenía el teclado. El texto está en la Ventana de grabación."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було відкрито й воно мало фокус клавіатури. Текст у Вікні запису."
          }
        }
      }
    },
    "%@ was open and had the keyboard. The text is still in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. %@ is a menu's name, or 'A menu'.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estaba abierto y tenía el teclado. El texto sigue en la Ventana de grabación."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було відкрито й воно мало фокус клавіатури. Текст досі у Вікні запису."
          }
        }
      }
    },
    "%@ wasn't in front when the instruction ended. Nothing was edited." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'Its app'.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no estaba al frente cuando terminó la instrucción. No se editó nada."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не був на передньому плані, коли інструкція закінчилася. Нічого не змінено."
          }
        }
      }
    },
    "%@ will become %@ in everything you dictate." : {
      "comment" : "Dictionary page, Add a word: preview under the form. The first %@ is the list of wrong spellings, each in quotes and struck through, separated by commas; the second %@ is the word, in bold.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ will become %2$@ in everything you dictate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se convertirá en %2$@ en todo lo que dictes."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ стане %2$@ в усьому, що ви диктуєте."
          }
        }
      }
    },
    "%@ wouldn't let the selected text be removed. The new version is on the clipboard." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'The app'.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no dejó quitar el texto seleccionado. La nueva versión está en el portapapeles."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не дозволив видалити виділений текст. Нова версія в буфері обміну."
          }
        }
      }
    },
    "%@ wpm" : {
