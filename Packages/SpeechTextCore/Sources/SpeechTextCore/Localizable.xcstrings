          "stringUnit" : {
            "state" : "translated",
            "value" : "Затиснувши %1$@, натисніть %2$@. Натисніть ще раз, щоб повернутися."
          }
        }
      }
    },
    "Words appear as you speak." : {
      "comment" : "Settings › Speech to text and setup: a speech model's row, the line under its name. Live text while recording.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras aparecen mientras hablas."
