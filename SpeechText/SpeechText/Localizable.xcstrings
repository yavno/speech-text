    "You speak at %@ words a minute and type at %@ — an average, until you set yours. In this period that's %@ you didn't spend typing." : {
      "comment" : "Usage page, the speed card. The first two %@ are speeds (bold numbers); the third a duration, e.g. ≈ 1 h 20 min.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You speak at %1$@ words a minute and type at %2$@ — an average, until you set yours. In this period that's %3$@ you didn't spend typing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablas a %1$@ palabras por minuto y escribes a %2$@ (una media, hasta que midas la tuya). En este periodo son %3$@ que no pasaste escribiendo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви говорите зі швидкістю %1$@ слів за хвилину, а друкуєте — %2$@ (середнє значення, доки не задасте своє). За цей період ви заощадили %3$@ на друкуванні."
          }
        }
      }
    },
    "You speak at %@ words a minute and type at %@. In this period that's %@ you didn't spend typing." : {
      "comment" : "Usage page, the speed card. The first two %@ are speeds (bold numbers); the third a duration, e.g. ≈ 1 h 20 min.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
