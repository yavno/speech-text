            "state" : "translated",
            "value" : "%1$@ виводиться з ужитку %2$@."
          }
        }
      }
    },
    "%@ s" : {
      "comment" : "A short duration in seconds with one decimal, e.g. 0.4 s, in the Usage page's request rows. %@ is the number, already formatted.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ с"
          }
        }
      }
    },
    "%@ — Intel Macs have no Neural Engine, so the larger models run too slowly for dictation." : {
      "comment" : "Settings › Speech to text: why a local model is recommended. %@ is the model's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: los Mac con Intel no tienen Neural Engine, así que los modelos más grandes van demasiado lentos para dictar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — у Mac з Intel немає Neural Engine, тож більші моделі працюють надто повільно для диктування."
          }
        }
      }
    },
    "%@ — Parakeet does not know every language you speak." : {
      "comment" : "Settings › Speech to text: why a local model is recommended. %@ is the model's name; Parakeet is another model's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Parakeet no conoce todos los idiomas que hablas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — Parakeet знає не всі мови, якими ви говорите."
          }
        }
      }
    },
    "%@/min." : {
      "comment" : "After a model-change notice: the price difference per minute of audio. %@ is a signed amount, e.g. +$0.0015.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
