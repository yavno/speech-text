          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма закрилася раніше, ніж текст був готовий. Текст у Вікні запису."
          }
        }
      }
    },
    "It quit. The text is still in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. 'It' is the app the text was to be inserted into.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró. El texto sigue en la Ventana de grabación."
