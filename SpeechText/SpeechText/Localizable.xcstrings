            "state" : "translated",
            "value" : "Це модель, що використовується. ШІ‑переписування вставлятиме ваші слова як сказано, доки ви не завантажите іншу."
          }
        }
      }
    },
    "It is the model in use. AI Rewrite switches to %@." : {
      "comment" : "Settings › AI Rewrite: message of the confirmation before removing the local model in use. %@ is the model switched to.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el modelo en uso. La Reescritura con IA cambia a %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це модель, що використовується. ШІ‑переписування перейде на %@."
          }
        }
      }
    },
    "It is the model in use. Dictation switches to %@ until you pick another." : {
      "comment" : "Settings › Speech to text: message of the confirmation before removing the local model in use. %@ is the model switched to.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
