    },
    "Keep %@ down — it alone keeps recording, and your hand is free for the mouse and ⌘Tab." : {
      "comment" : "Setup window, Try it step: %@ is the shortcut's letter key, e.g. Q.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
