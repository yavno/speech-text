    },
    "%@ billed" : {
      "comment" : "Usage page, Requests: audio a vendor billed. %@ is a duration, e.g. 12 min."
    },
    "%@ billed (%lld of %lld reported)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ billed (%2$lld of %3$lld reported)"
          }
        }
      },
      "comment" : "Usage page, Requests: audio billed, when only some requests reported it. %@ is a duration; the numbers are requests."
    },
    "%@ charges about %@ an hour more for a transcription that carries them." : {
      "comment" : "Dictionary page, What a word does: sentence after the count. The first %@ is the vendor, the second a price (e.g. $0.12).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ charges about %2$@ an hour more for a transcription that carries them."
          }
        }
      }
    },
    "%@ faster" : {
      "comment" : "Usage page: the large figure, how much faster speaking is than typing. %@ is e.g. 3.6× (shown larger)."
