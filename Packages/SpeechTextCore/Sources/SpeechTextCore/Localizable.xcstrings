    },
    "While holding %@, press %@. Press it again to switch back." : {
      "comment" : "Tip text. The first %@ is the held key (e.g. Q), the second the other shortcut (e.g. ⌃⇧W). Two lines at most.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While holding %1$@, press %2$@. Press it again to switch back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras mantienes %1$@, pulsa %2$@. Vuelve a pulsarlo para volver."
          }
        },
