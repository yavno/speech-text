          "stringUnit" : {
            "state" : "translated",
            "value" : "Це модель, що використовується. Диктування перейде на %@, доки ви не виберете іншу."
          }
        }
      }
    },
    "It quit before the text was ready. The text is in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. 'It' is the app the text was to be pasted into.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
