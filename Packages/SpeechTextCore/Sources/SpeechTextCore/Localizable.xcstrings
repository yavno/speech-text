    "A failed one's audio is kept as long as the dictation, for a retry." : {
      "comment" : "History page, at the foot: a failed dictation's recording is kept as long as the dictation itself.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio de un dictado fallido se conserva tanto como el dictado, para reintentarlo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудіо невдалої диктовки зберігається стільки ж, скільки сама диктовка, — для повторної спроби."
          }
        }
      }
    },
    "A failed one's audio is kept for 3 months, for a retry." : {
      "comment" : "History page, at the foot: how long a failed dictation's recording is kept so it can be retried.",
      "localizations" : {
