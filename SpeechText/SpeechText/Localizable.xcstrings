    },
    "While holding %@, press %@ to switch to AI Rewrite, and again to switch back. Started with %@, %@ switches the other way." : {
      "comment" : "Settings › Dictation › Recording › Switch to AI Rewrite: gesture text in hold-to-talk mode. The first %@ is the dictation shortcut's letter, the second and third the AI Rewrite shortcut, the fourth the dictation shortcut.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While holding %1$@, press %2$@ to switch to AI Rewrite, and again to switch back. Started with %3$@, %4$@ switches the other way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras mantienes %1$@, pulsa %2$@ para cambiar a Reescritura con IA, y otra vez para volver. Si empezaste con %3$@, %4$@ cambia en sentido contrario."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затиснувши %1$@, натисніть %2$@, щоб перейти на ШІ‑переписування, і ще раз, щоб повернутися. Якщо почати з %3$@, %4$@ перемикає навпаки."
          }
        }
      }
    },
    "While it records, press %@ to switch to AI Rewrite and %@ to switch back. Started with %@, it works the other way round." : {
      "comment" : "Settings › Dictation › Recording › Switch to AI Rewrite: gesture text in press-to-toggle mode. The first and third %@ are the AI Rewrite shortcut, the second the dictation shortcut.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While it records, press %1$@ to switch to AI Rewrite and %2$@ to switch back. Started with %3$@, it works the other way round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras graba, pulsa %1$@ para cambiar a Reescritura con IA y %2$@ para volver. Si empezaste con %3$@, funciona al revés."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час запису натисніть %1$@, щоб перейти на ШІ‑переписування, і %2$@, щоб повернутися. Якщо почати з %3$@, усе працює навпаки."
          }
        }
      }
    },
    "While the overlay is up, Esc cancels the dictation — and reaches no other app until it is gone." : {
      "comment" : "Settings › Dictation › Recording › Esc cancels a dictation: caption when on.",
      "localizations" : {
        "es" : {
