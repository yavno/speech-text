    },
    "Its model is still downloading (%lld%%). You can wait here, or try it later." : {
      "comment" : "Setup window, Try it step: the AI model is still downloading. %lld is the percent; keep %%.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
