      }
    },
    "The app the Record Window was opened from is gone. Copy the text instead." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Record Window (the app's floating dictation window): ",
      "localizations" : {
        "es" : {
          "stringUnit" : {
