        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудіо зберігається %@ — для повторної спроби з поточними налаштуваннями."
          }
        }
      }
    },
    "The audio is no longer kept, so this one can't be retried." : {
      "comment" : "History page, an open failed dictation whose audio was deleted.",
      "localizations" : {
        "es" : {
