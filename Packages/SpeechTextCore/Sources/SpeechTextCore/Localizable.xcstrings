          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio de un dictado fallido se conserva 3 meses, para reintentarlo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудіо невдалої диктовки зберігається 3 місяці — для повторної спроби."
          }
        }
      }
    },
    "A failed one's audio is kept for 30 days, for a retry." : {
