{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ alone keeps recording, so clicks and ⌘Tab work as usual." : {
      "comment" : "Tip text. %@ is the shortcut's letter key, e.g. Q. Two lines at most.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta con mantener %@ para seguir grabando, así los clics y ⌘Tab funcionan como siempre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки затиснуто лише %@, запис триває, тож клацання й ⌘Tab працюють як завжди."
          }
        }
      }
    },
    "%@ can't take %@ on this Mac." : {
      "comment" : "Warning under 'Languages I speak' for Apple's recognizer. The first %@ is the model's name, the second one or more languages.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't take %2$@ on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no admite %2$@ en este Mac."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не підтримує на цьому Mac: %2$@."
          }
        }
      }
    },
    "%@ can't take %@." : {
      "comment" : "Warning under 'Languages I speak'. The first %@ is the selected model's name, the second one or more languages.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't take %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no admite %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не підтримує: %2$@."
          }
        }
      }
    },
    "%@ couldn't transcribe the recording: %@ (HTTP %lld)" : {
      "comment" : "Dictation error. The first %@ is the vendor, the second why (the service's own words, often English, or one of the reasons), %lld the HTTP status code.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't transcribe the recording: %2$@ (HTTP %3$lld)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ha podido transcribir la grabación: %2$@ (HTTP %3$lld)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: не вдалося транскрибувати запис — %2$@ (HTTP %3$lld)"
          }
        }
      }
    },
    "%@ for a %@ Mac." : {
      "comment" : "Settings › Speech to text: why a local model is recommended. The first %@ is the model's name, the second this Mac's class (e.g. '16 GB class').",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ for a %2$@ Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ para un Mac de %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ для Mac (%2$@)."
          }
        }
      }
    },
    "%@ is no longer available." : {
      "comment" : "Notice text: the model that was in use is gone. %@ is its name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está disponible."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ більше недоступна."
          }
        }
      }
    },
    "%@ is retiring." : {
      "comment" : "Notice text after the app moved to a new model. %@ is the old model's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se va a retirar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ виводиться з ужитку."
          }
        }
      }
    },
    "%@ isn't installed — download it in Settings." : {
      "comment" : "History: why a failed dictation can't be retried. %@ is a local model's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está instalado: descárgalo en Ajustes."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не встановлено — завантажте її в Параметрах."
          }
        }
      }
    },
    "%@ only" : {
      "comment" : "A model row's subtitle when the model knows one language: e.g. 'English only'. %@ is the language's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "лише %@"
          }
        }
      }
    },
    "%@ or %@" : {
      "comment" : "Joins the last two languages of a list in the warning '… can't take %@.' The first %@ is the list so far (comma-separated), the second the last language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ or %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ o %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ або %2$@"
          }
        }
      }
    },
    "%@ retires on %@." : {
      "comment" : "Notice text after the app moved to a new model. The first %@ is the old model's name, the second the date it is switched off.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ retires on %2$@."
          }
        },
