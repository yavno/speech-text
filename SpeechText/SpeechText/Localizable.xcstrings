{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "comment" : "An empty label (a text field whose placeholder is given separately). Leave it empty."
    },
    "%@ (not connected)" : {
      "comment" : "Settings › Dictation › Microphone: menu item for the microphone the user picked when it is not connected. %@ is the microphone's name."
    },
    "%@ billed" : {
      "comment" : "Usage page, Requests: audio a vendor billed. %@ is a duration, e.g. 12 min."
    },
    "%@ billed (%lld of %lld reported)" : {
      "comment" : "Usage page, Requests: audio billed, when only some requests reported it. %@ is a duration; the numbers are requests.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ billed (%2$lld of %3$lld reported)"
          }
        }
      }
    },
    "%@ charges about %@ an hour more for a transcription that carries them." : {
      "comment" : "Dictionary page, What a word does: sentence after the count. The first %@ is the vendor, the second a price (e.g. $0.12).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ charges about %2$@ an hour more for a transcription that carries them."
          }
        }
      }
    },
    "%@ didn't come back to the front, so nothing was pasted into it." : {
      "comment" : "Notice beside the dictation overlay: text under the title. after AI Rewrite in the Record Window. %@ is an app's name, or 'The app'."
    },
    "%@ faster" : {
      "comment" : "Usage page: the large figure, how much faster speaking is than typing. %@ is e.g. 3.6× (shown larger)."
    },
    "%@ in all · %@" : {
      "comment" : "Usage page, the chart's note: the period's total cost. The first %@ is a cost, e.g. ≈ $1.20; the second says it is estimated from known prices.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in all · %2$@"
          }
        }
      }
    },
    "%@ is already the %@ shortcut. Choose another one." : {
      "comment" : "Settings › Dictation › Shortcuts: warning under a shortcut. The first %@ is the keys (e.g. ⌃⇧Q), the second the name of the other shortcut that already uses them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already the %2$@ shortcut. Choose another one."
          }
        }
      }
    },
    "%@ is given them" : {
      "comment" : "Dictionary page, What a word does: row title. %@ is the speech engine's vendor (e.g. OpenAI); 'them' is the user's words."
    },
    "%@ is newer." : {
      "comment" : "Settings › Speech to text / AI Rewrite: note under a service's models when a newer model replaces the selected one. %@ is the newer model's name. Followed by a 'Switch to it' link."
    },
    "%@ is reserved by another app, so it won't work. Choose another shortcut." : {
      "comment" : "Settings › Dictation › Shortcuts: warning under a shortcut macOS would not register. %@ is the keys, e.g. ⌃⇧Q."
    },
    "%@ isn't downloaded — download it in Settings › AI Rewrite." : {
      "comment" : "Error when a local AI Rewrite model is missing. %@ is the model's name; Settings › AI Rewrite is a place in Settings."
    },
    "%@ isn't given them" : {
      "comment" : "Dictionary page, What a word does: row title. %@ is the name of the speech model in use."
    },
    "%@ isn't installed" : {
      "comment" : "Notice beside the dictation overlay: title, one short line. %@ is a speech model's name."
    },
    "%@ key" : {
      "comment" : "VoiceOver label of an API key field. %@ is the service's name, e.g. Groq."
    },
    "%@ key, ending %@" : {
      "comment" : "Settings: VoiceOver label of a stored API key. The first %@ is the service's name, the second the key's last four characters.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ key, ending %2$@"
          }
        }
      }
    },
    "%@ left" : {
      "comment" : "Usage page, Limits: what is left of a rate limit. %@ is a number."
    },
    "%@ of %@ left" : {
      "comment" : "Usage page, Limits: what is left of a rate limit, e.g. 13,999 of 14,400 left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ left"
          }
        }
      }
    },
    "%@ of audio" : {
      "comment" : "Usage page, By engine: how much audio a speech engine heard. %@ is a duration, e.g. 12 min."
    },
    "%@ of models on this Mac" : {
      "comment" : "Settings › Speech to text / AI Rewrite › Models on this Mac: how much disk the downloaded models take. %@ is a size, e.g. 1.2 GB."
    },
    "%@ sent" : {
      "comment" : "Usage page, Requests: audio sent to a vendor. %@ is a duration."
    },
    "%@ sent again from History" : {
      "comment" : "Usage page, Overhead: audio sent again by retries. %@ is a duration."
    },
    "%@ tokens in · %@ out" : {
      "comment" : "Usage page, Requests: tokens sent and received, e.g. 48.2k tokens in · 3.1k out.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ tokens in · %2$@ out"
          }
        }
      }
    },
    "%@ took it out late, once it wasn't in front. Paste it back with ⌘V." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'The app'. ⌘V is the paste shortcut."
    },
    "%@ was open and had the keyboard, so nothing was pasted into %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was open and had the keyboard, so nothing was pasted into %2$@."
          }
        }
      },
      "comment" : "Notice beside the dictation overlay: text under the title. the first %@ is a menu's name or 'A menu', the second an app's name or 'the app'."
    },
    "%@ was open and had the keyboard. The text is in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. %@ is a menu's name, or 'A menu'."
    },
    "%@ was open and had the keyboard. The text is still in the Record Window." : {
      "comment" : "Notice beside the dictation overlay: text under the title. %@ is a menu's name, or 'A menu'."
    },
    "%@ wasn't in front when the instruction ended. Nothing was edited." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'Its app'."
    },
    "%@ will become %@ in everything you dictate." : {
      "comment" : "Dictionary page, Add a word: preview under the form. The first %@ is the list of wrong spellings, each in quotes and struck through, separated by commas; the second %@ is the word, in bold.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ will become %2$@ in everything you dictate."
          }
        }
      }
    },
    "%@ wouldn't let the selected text be removed. The new version is on the clipboard." : {
      "comment" : "Notice beside the dictation overlay: text under the title. Edit Selection with AI (rewrites the text selected in another app): %@ is an app's name, or 'The app'."
    },
    "%@ wpm" : {
      "comment" : "Usage page: under a speed column, the figure and the unit (words per minute). %@ is the figure, shown larger."
    },
    "%@ · %lld%%" : {
      "comment" : "Setup window: a download in progress. %@ is what is downloading (e.g. Speech model, or a model's name), %lld the percent done. Keep %%.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld%%"
          }
        }
      }
    },
    "%@ · Choose a model" : {
      "comment" : "Home page, Engines: the speech engine row when its vendor has no model chosen. %@ is the vendor, e.g. OpenAI."
