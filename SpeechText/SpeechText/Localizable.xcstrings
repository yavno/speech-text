          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов'язково. Перетворює диктування на готовий текст — лист, список, переклад — або робить те, про що ви просите («коротка відповідь англійською»)."
          }
