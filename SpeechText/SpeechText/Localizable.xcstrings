            "value" : "Працює!"
          }
        }
      }
    },
    "It's given your words with every AI dictation and told to spell them your way." : {
      "comment" : "Dictionary page, What a word does: row text when AI Rewrite is set up.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe tus palabras con cada dictado con IA y se le pide que las escriba a tu manera."
